{
    "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.14.2/.schema/devbox.schema.json",
    "packages": [
        "pixi@0.49.0"
    ],
    "env": {
        "PY_IGNORE_IMPORTMISMATCH": "1"
    },
    "shell": {
        "scripts": {
            "init": [
                "pixi install --all"
            ],
            "init-dev": [
                "devbox run init",
                "pixi run --environment dev pre-commit install"
            ],
            "clean": [
                "git clean -d -x -i"
            ],
            "test": [
                "devbox run test-ruff",
                "devbox run test-mypy",
                "devbox run test-pytest"
            ],
            "test-ruff": [
                "devbox run check"
            ],
            "test-mypy": [
                "pixi run --environment dev mypy --show-error-codes src"
            ],
            "test-pytest": [
                "pixi run --environment dev python -m pytest --log-level=INFO --exitfirst tests"
            ],
            "format": [
                "pixi run --environment dev ruff format ."
            ],
            "check-fix": [
                "pixi run --environment dev ruff check --no-show-fixes --quiet --fix ."
            ],
            "check": [
                "pixi run --environment dev ruff check --no-show-fixes --quiet ."
            ],
            "pre-commit": [
                "pixi run --environment dev pre-commit run --all-files"
            ],
            "sort": [
                "pixi run --environment dev ruff check --select I --fix .",
                "pixi run --environment dev ruff format ."
            ]
        }
    }
}
