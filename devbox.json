{
    "$schema":  "https://raw.githubusercontent.com/jetify-com/devbox/0.14.2/.schema/devbox.schema.json",
    "packages": ["python@3.14"],
    "env": {
        "PY_IGNORE_IMPORTMISMATCH": "1"
    },
    "shell": {
        "init_hook": [
            ". $VENV_DIR/bin/activate"
        ],
        "scripts": {
            "init": [
                "pip install --upgrade pip",
                "pip install -e ."
            ],
            "init-dev": [
                "devbox run init",
                "pip install -e '.[dev]'",
                "pre-commit install"
            ],
            "clean": [
                "git clean -d -x -i"
            ],
            "test": [
                "devbox run test-mypy",
                "devbox run test-pytest"
            ],
            "test-mypy": [
                "mypy --show-error-codes src"
            ],
            "test-pytest": [
                "python -m pytest --log-level=INFO --exitfirst tests"
            ],
            "format": [
                "ruff format ."
            ],
            "check-fix": [
                "ruff check --no-show-fixes --quiet --fix ."
            ],
            "check": [
                "ruff check --no-show-fixes --quiet ."
            ],
            "pre-commit": [
                "pre-commit run --all-files"
            ],
            "sort": [
                "ruff check --select I --fix .",
                "ruff format ."
            ]
        }
    }
}
